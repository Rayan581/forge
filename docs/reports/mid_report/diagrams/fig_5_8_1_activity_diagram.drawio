<mxfile host="app.diagrams.net"><diagram name="fig_5_8_1_activity_diagram" id="fig_5_8_1_activity_diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="303" y="10" width="24" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Main menu&lt;/b&gt; → Start Run&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;_on_start_run_requested()&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="60" width="240" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;build_new_dungeon(level)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;calibration preset (floors 1–5) or PPO params (6+);&lt;br&gt;generate_dungeon → Rooms → Player in start room&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="175.0" y="140" width="280" height="75" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Explore rooms, fight enemies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TelemetryLogger.record_*()&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="245" width="240" height="55" as="geometry"/></mxCell><mxCell id="c6" value="Player dies?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="330" width="240" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;record_death · save_to_file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1.2 s delay → respawn in start room&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="335" width="200" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Exit room cleared → ExitPortal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Room emits dungeon_escaped&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="440" width="240" height="55" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Measure floor&lt;/b&gt;: time, deaths, damage taken&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;floors 1–5: record_calibration_floor()&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="175.0" y="525" width="280" height="55" as="geometry"/></mxCell><mxCell id="c10" value="Floor index?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="610" width="240" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Floors 1–4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no PPO step; next fixed&lt;br&gt;calibration preset is applied&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="740" width="175" height="85" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Floor 5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;compute_cr0_baseline() →&lt;br&gt;build_observation_from_cr0(CR₀, 6) →&lt;br&gt;predict → apply_ppo_action&lt;br&gt;(floor 6 seeded from CR₀)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="227" y="740" width="175" height="105" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Floor ≥ 6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;build_observation(time, deaths,&lt;br&gt;damage, max_hp, level) →&lt;br&gt;predict → apply_ppo_action&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="740" width="190" height="105" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;save_to_file()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;session_telemetry.json&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="890" width="240" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;build_new_dungeon(level + 1)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195.0" y="970" width="240" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="975" width="30" height="30" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometr