<mxfile host="app.diagrams.net"><diagram name="fig_1_1_system_overview" id="fig_1_1_system_overview"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Player (human)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WASD · attack · dash&lt;br&gt;⇄ rendered game + HUD&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="200" height="120" as="geometry"/></mxCell><mxCell id="c3" value="GitHub Actions CI" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="200" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ci_solvability_runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;calls generate_dungeon()&lt;br&gt;× 500 seeds · BFS check&lt;br&gt;&lt;br&gt;ruff · pytest · policy tests&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="32" y="345" width="176" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Godot 4.x Runtime (GDScript): all inference on-device, no external runtime" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=#FBFBFB;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="820" height="640" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Gameplay Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Main · Room · Player ·&lt;br&gt;Enemy · ProjectileFireball&lt;br&gt;60 FPS combat, 2D physics&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="190" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Telemetry &amp;amp; Profiling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TelemetryLogger&lt;br&gt;clear time · deaths · damage ratio&lt;br&gt;CR&lt;sub&gt;0&lt;/sub&gt; over floors 1–5&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="190" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;session_telemetry.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;last 50 records&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=document;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="85" width="190" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Dungeon Generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Stage 1: room layout,&lt;br&gt;doors → connected graph&lt;br&gt;Stage 2: enemies + hazards&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="190" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;DifficultyManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;builds s&lt;sub&gt;t&lt;/sub&gt; (8-dim) · applies a&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;calibration · static-baseline mode&l