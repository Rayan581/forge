<mxfile host="app.diagrams.net"><diagram name="fig_e_1_two_stage_procedural_pipeline" id="fig_e_1_two_stage_procedural_pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DifficultyManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;room_count_target&lt;br&gt;hazard_density&lt;br&gt;resource_scarcity&lt;br&gt;enemy_count_scale&lt;br&gt;ranged_enemy_ratio&lt;br&gt;enemy_health · damage&lt;br&gt;enemy_speed · aggro&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="15" y="120" width="170" height="200" as="geometry"/></mxCell><mxCell id="c3" value="Stage 1 · Topology — generate_dungeon()" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=#EAF1FB;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="15" width="360" height="440" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;① Random walk with branching&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pick a room from the queue, add a neighbour in a random free direction, open matching N/S/E/W doors until room_count_target is reached&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="55" width="330" height="75" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;② Exit room&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;room with the maximum Manhattan distance from the start room&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="330" height="55" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;③ Assign room roles (shuffled)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HAZARD = clamp(⌊hazard_density × n⌋, 1, n)&lt;br&gt;TREASURE = clamp(⌊(1 − scarcity) × 2.5⌋, 1, 3)&lt;br&gt;remaining rooms = COMBAT&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="205" width="330" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;④ Per-room counts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;enemies, hazards, pickups; enemy counts × enemy_count_scale&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="295" width="330" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;⑤ World placement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;grid position × (880×520 room + 120 px spacing)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="355" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Stage 2 · Population — Room.spawn_entities()" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=#EAF6E7;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="15" width="320" height="440" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Hazards &amp;amp; pickups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;random positions inside the room&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="55" width="290" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Archetype per enemy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pyromancer with probability ranged_enemy_ratio, otherwise Crawler&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="135" width="290" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;configure_parameters()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;health · damage · speed · aggro from the PPO action&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="290" height="65" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Exit-room champion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;if enemy_health ≥ 85: lead crawler ×1.7 HP, ×1.25 damage, scale 1.28&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="290" height="75" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Playable floor&lt;/b&gt;: Room scenes · MiniMap · Player" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="402" width="290" height="40" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Offline validation (not a runtime step)&lt;/b&gt; — tests/ci_solvability_runner.gd: BFS over the door graph, 