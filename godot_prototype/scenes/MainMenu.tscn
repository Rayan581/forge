[node name="BriefingBody" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.98, 1)
theme_override_font_sizes/font_size = 13
text = "Welcome to FORGE. The first 5 dungeon floors execute a structured Cold-Start Placement Protocol (Proposal §5.4). During these floors, the system continuously tracks your telemetry (combat pace, evasion, and damage intake) across calibrated challenge vectors to establish your initial skill rating (CR₀).

Upon exiting Floor 5, the live Adaptive Closed-Loop PPO policy engages for Floor 6 onwards, generating bespoke dungeons tailored specifically to you."
autowrap_mode = 2

[node name="ProtocolBox" type="VBoxContainer" parent="Control/BriefingPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="L1" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 1)
theme_override_font_sizes/font_size = 12
text = "• Level 1: Novice Initiation — Baseline movement, 3 rooms, slow adversaries."

[node name="L2" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 1)
theme_override_font_sizes/font_size = 12
text = "• Level 2: Swarm Reflex — 4 rooms, 2-3 adversaries/room, testing melee response."

[node name="L3" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 1)
theme_override_font_sizes/font_size = 12
text = "• Level 3: Evasion & Traps — 4 rooms, spikes & high-speed adversaries."

[node name="L4" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 1)
theme_override_font_sizes/font_size = 12
text = "• Level 4: Tactical Crucible — 5 rooms, resilient foes and scarce potions."

[node name="L5" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 1)
theme_override_font_sizes/font_size = 12
text = "• Level 5: Apex Gauntlet — 5 rooms, stress test before PPO activation."

[node name="L6" type="Label" parent="Control/BriefingPanel/MarginContainer/VBoxContainer/ProtocolBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.9, 0.6, 1)
theme_override_font_sizes/font_size = 12
