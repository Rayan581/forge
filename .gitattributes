# Store text with LF line endings in the repository, whatever the OS / core.autocrlf setting.
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svgz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.ogg binary
*.mp3 binary
*.pdf binary
*.zip binary
*.pptx binary
*.docx binary
*.xlsx binary
*.pt binary
*.pth binary
*.npz binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.dylib binary
*.wasm binary
*.pck binary
*.db binary
*.sqlite binary
